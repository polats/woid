.env

node_modules
dist
dist-mobile

# Capacitor native platform projects — generated locally via
# `npm run mobile:add:ios` / `mobile:add:android`. Anchored to repo root
# so we don't accidentally ignore plugin source under mobile/plugins/*.
/ios/
/android/

# Gradle build artifacts for our local Capacitor plugins. Plugin source
# lives in mobile/plugins/<name>/{src,android/src,android/build.gradle};
# everything under build/ is regenerable.
mobile/plugins/*/android/build/
mobile/plugins/*/android/.cxx/

.DS_Store
*.log
.github-token

# Claude Code per-session state
.claude/

# Agent sandbox — local env holds NVIDIA_NIM_API_KEY
agent-sandbox/.env

# Ad-hoc reference dumps dropped into references/ — track via submodule or
# curate before checking in.
references/Woid Design System-handoff/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
testing/sessions/

# Local e2e pipeline outputs (intermediates: avatar/tpose/model/rig per
# character, plus report.json). Trivially regenerable; large GLBs.
/scripts/e2e-runs/
/e2e-runs/

# Python bytecode
__pycache__/
*.pyc

# Bridge probe scripts — ad-hoc debug helpers, never source-of-truth.
agent-sandbox/pi-bridge/probe*.mjs

# Native binaries for the on-device imagen plugin — vendored locally
# from the Qualcomm AI SDK release. Too large for git; document install
# steps separately and fetch as part of mobile setup.
mobile/plugins/imagen/android/src/main/assets/qnnlibs/
mobile/plugins/imagen/android/src/main/jniLibs/

# Third-party reference clones kept locally for inspiration; not ours.
# (polats-radio is an embedded git repo — git treats it as a submodule,
# so .gitignore can't suppress its status line. Don't `git add` it.)
